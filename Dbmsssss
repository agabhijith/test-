CREATE TABLE BANK(
    bankcode VARCHAR(3),
    bankname VARCHAR(30) NOT NULL,
    headoffice VARCHAR(30),
    branches INT NOT NULL CHECK(branches > 0),
    PRIMARY KEY(bankcode)
);



